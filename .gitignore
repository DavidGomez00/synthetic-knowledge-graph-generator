# Python bytecode
*/__pycache__/*
*.pyc
*.pyo
*.pyd
.ruff_cache
# Virtual environment and package metadata written by pip install -e .
.venv/
*.egg-info/

# Local settings
.env
.mypy_cache
.vscode
.python-version
.claude
.env
pdfs

# Local data
.data

# logs: only the logs of synthetic graph generation are tracked (our generator's
# logs/ours*/, the output of the generation batches and of cli/main.py runs)
logs/*
!logs/ours*/
!logs/rule-levels-*.out
!logs/kbgen-*.out
!logs/synthetic.*.log

# Output of scripts/train_kge.py: exp_results is tracked, except the progress table, rewritten after every epoch
exp_results/progress.csv
exp_results/progress.csv.*.tmp
!exp_results/*/logs/
exp_checkpoints

# Test runs
src/skgg/cli/test.py
tests/

# AMIE binary (download separately, see mine_rules/run_amie.py)
mine_rules/*.jar

# State of a running validation (kgc_benchmark/report_results.py), local to each machine
exp_analysis/progress.csv
exp_analysis/validation_state.json
exp_analysis/.validation.lock
exp_analysis/**/.*.tmp

# kbgen's working files of the rule-level copies (runs/*/kbgen-work/, or the driver's
# default runs/rule-levels/kbgen/work/): the tensors, models and synthetic graphs are
# ignored; the logs, the rules kbgen was given and each run's records are tracked
runs/*/kbgen-work/**
runs/*/kbgen/work/**
!runs/*/kbgen-work/**/
!runs/*/kbgen/work/**/
!runs/*/kbgen-work/**/*.log
!runs/*/kbgen/work/**/*.log
!runs/*/kbgen-work/**/*-AmieRules.txt
!runs/*/kbgen/work/**/*-AmieRules.txt
!runs/*/kbgen-work/**/stats.json
!runs/*/kbgen/work/**/stats.json
!runs/*/kbgen-work/**/timings.json
!runs/*/kbgen/work/**/timings.json
!runs/*/kbgen-work/**/*.counts.json
!runs/*/kbgen/work/**/*.counts.json

# Output of the hyperparameter search, removed on 2026-11-16 with scripts/tune_kge.py
exp_hpo/
