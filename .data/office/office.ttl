@prefix ex: <http://example.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .

# --- Persons ---

ex:Alice a foaf:Person ;
    foaf:knows ex:Bob ;
    schema:works_for ex:TechCorp ;
    ex:assignedTo ex:Project_A .

ex:Bob a foaf:Person ;
    foaf:knows ex:Alice, ex:Charlie ;
    ex:reportsTo ex:Alice ;
    schema:works_for ex:TechCorp .

ex:Charlie a foaf:Person ;
    foaf:knows ex:Bob ;
    ex:reportsTo ex:Bob;
    ex:assignedTo ex:Project_A .

# --- Organization ---

ex:TechCorp a schema:Organization .

# --- Project ---

ex:Project_A a schema:Project .
