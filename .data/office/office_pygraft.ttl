@prefix ns1: <http://pygraf.t/> .

ns1:E2 a ns1:Organization .

ns1:E1 a ns1:Person ;
    ns1:assigned_to ns1:E3 ;
    ns1:knows ns1:E4,
        ns1:E5 .

ns1:E4 a ns1:Person ;
    ns1:assigned_to ns1:E3 ;
    ns1:reports_to ns1:E1,
        ns1:E5 ;
    ns1:works_for ns1:E2 .

ns1:E5 a ns1:Person ;
    ns1:assigned_to ns1:E3 ;
    ns1:knows ns1:E4 ;
    ns1:reports_to ns1:E1 .

ns1:E3 a ns1:Project .

