  sm:servantOf sm:Peach .

sm:Yoshi sm:allyOf sm:Luigi, sm:Mario, sm:Peach, sm:Toad, sm:Toadette;
  sm:enemyOf sm:Bowser, sm:BowserJr, sm:Kamek .

sm:Luigi sm:allyOf sm:Mario, sm:Daisy, sm:Peach, sm:Rosalina, sm:Toad, sm:Toadette, sm:Yoshi;
  sm:brotherOf sm:Mario;
  sm:enemyOf sm:Bowser, sm:BowserJr, sm:Kamek, sm:KingBoo, sm:Waluigi;
  sm:loves sm:Daisy;
  sm:servantOf sm:Peach .

sm:Mario sm:allyOf sm:Luigi, sm:Peach, sm:Daisy, sm:Rosalina, sm:Toad, sm:Toadette, sm:Yoshi;
  sm:brotherOf sm:Luigi;
  sm:enemyOf sm:Bowser, sm:BowserJr, sm:Kamek, sm:KingBoo, sm:Wario;
  sm:loves sm:Peach;
  sm:servantOf sm:Peach .

