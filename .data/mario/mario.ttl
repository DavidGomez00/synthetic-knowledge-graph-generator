  sm:servantOf sm:Bowser, sm:BowserJr .

sm:KingBoo sm:allyOf sm:Bowser;
  sm:enemyOf sm:Luigi, sm:Mario .

sm:Waluigi sm:allyOf sm:Wario;
  sm:loves sm:Daisy;
  sm:enemyOf sm:Luigi .

sm:Wario sm:allyOf sm:Waluigi;
  sm:loves sm:Peach;
  sm:enemyOf sm:Mario .

sm:Rosalina sm:allyOf sm:Peach, sm:Mario, sm:Luigi .

sm:Daisy sm:allyOf sm:Peach, sm:Mario, sm:Luigi;
