sm:Peach sm:allyOf sm:Daisy, sm:Rosalina, sm:Luigi, sm:Mario, sm:Toad, sm:Toadette, sm:Yoshi;
  sm:enemyOf sm:Bowser, sm:BowserJr, sm:Kamek .

