# SHACL-SPARQL shapes for the French Royalty KG.
#
# Each relation in French Royalty is irreflexive and is read from subject to object.
# For example, "child" is read as "has child" or "spouse" is read as "has spouse".
#
# Each block also binds the triple as written in the file (`$this ?path ?value`
# or `?this2 ?path2 ?value2`), so the report names it.

# Prefixes
# ex: must equal the experiment namespace

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix ex:   <http://FrenchRoyalty.org/> .

# Irreflexive relations: no relation links a person to themselves.

ex:Irreflexive a sh:NodeShape ;
    sh:targetSubjectsOf ex:child , ex:parent , ex:father , ex:mother , ex:spouse , ex:successor , ex:predecessor ;
    sh:sparql [
        sh:message "Nobody is related to themselves" ;
        sh:select """
            SELECT $this ?path ?value
            WHERE {
                $this ?path ?value .
                VALUES ?path { ex:child ex:parent ex:father ex:mother ex:spouse ex:successor ex:predecessor }
                FILTER (sameTerm($this, ?value))
            }
        """ ;
    ] .

# Asymmetric parentage: nobody is both the parent and the child of the same
# person, whichever of `parent`, `father`, `mother` or `child` each triple uses

ex:ParentageAsymmetric a sh:NodeShape ;
    sh:targetSubjectsOf ex:parent , ex:father , ex:mother , ex:child ;
    sh:sparql [
        sh:message "Nobody is both parent and child of the same person" ;
        sh:select """
            SELECT $this ?path ?value ?this2 ?path2 ?value2
            WHERE {
                {
                    $this ?path ?value .
                    VALUES ?path { ex:parent ex:father ex:mother }
                    BIND ($this AS ?child)
                    BIND (?value AS ?parent)
                } UNION {
                    $this ex:child ?value .
                    BIND (ex:child AS ?path)
                    BIND ($this AS ?parent)
                    BIND (?value AS ?child)
                }
                {
                    ?parent ?path2 ?child .
                    VALUES ?path2 { ex:parent ex:father ex:mother }
                    BIND (?parent AS ?this2)
                    BIND (?child AS ?value2)
                } UNION {
                    ?child ex:child ?parent .
                    BIND (ex:child AS ?path2)
                    BIND (?child AS ?this2)
                    BIND (?parent AS ?value2)
                }
            }
        """ ;
    ] .

# Disjoint roles: nobody is the father of one person and the mother of
# another. When both are the same person, this is someone who has the same
# person as father and as mother.

ex:FatherOrMother a sh:NodeShape ;
    sh:targetSubjectsOf ex:father ;
    sh:sparql [
        sh:message "Nobody is both a father and a mother" ;
        sh:select """
            SELECT $this ?path ?value ?this2 ?path2 ?value2
            WHERE {
                $this ex:father ?value .
                ?this2 ex:mother ?value .
                BIND (ex:father AS ?path)
                BIND (ex:mother AS ?path2)
                BIND (?value AS ?value2)
            }
        """ ;
    ] .

# Acyclic parentage: nobody is their own ancestor. Every parentage triple on a
# cycle is reported. Cycles of one or two triples are also caught by
# ex:Irreflexive and ex:ParentageAsymmetric; this shape is there for longer ones.

ex:AncestryAcyclic a sh:NodeShape ;
    sh:targetSubjectsOf ex:parent , ex:father , ex:mother , ex:child ;
    sh:sparql [
        sh:message "Nobody is their own ancestor" ;
        sh:select """
            SELECT $this ?path ?value
            WHERE {
                {
                    $this ?path ?value .
                    VALUES ?path { ex:parent ex:father ex:mother }
                    BIND ($this AS ?child)
                    BIND (?value AS ?parent)
                } UNION {
                    $this ex:child ?value .
                    BIND (ex:child AS ?path)
                    BIND ($this AS ?parent)
                    BIND (?value AS ?child)
                }
                ?parent (ex:parent|ex:father|ex:mother|^ex:child)+ ?child .
            }
        """ ;
    ] .

# Disjoint relations: nobody is married to their own parent or child.

ex:SpouseNotParentage a sh:NodeShape ;
    sh:targetSubjectsOf ex:spouse ;
    sh:sparql [
        sh:message "Nobody is married to their own parent or child" ;
        sh:select """
            SELECT $this ?path ?value ?this2 ?path2 ?value2
            WHERE {
                $this ex:spouse ?value .
                BIND (ex:spouse AS ?path)
                {
                    $this ?path2 ?value .
                    BIND ($this AS ?this2)
                    BIND (?value AS ?value2)
                } UNION {
                    ?value ?path2 $this .
                    BIND (?value AS ?this2)
                    BIND ($this AS ?value2)
                }
                VALUES ?path2 { ex:parent ex:father ex:mother ex:child }
            }
        """ ;
    ] .

# Asymmetric succession: if A came before B, B did not come before A.

ex:SuccessionAsymmetric a sh:NodeShape ;
    sh:targetSubjectsOf ex:successor , ex:predecessor ;
    sh:sparql [
        sh:message "Nobody both precedes and succeeds the same person" ;
        sh:select """
            SELECT $this ?path ?value ?this2 ?path2 ?value2
            WHERE {
                {
                    $this ex:successor ?value .
                    BIND (ex:successor AS ?path)
                    BIND ($this AS ?earlier)
                    BIND (?value AS ?later)
                } UNION {
                    $this ex:predecessor ?value .
                    BIND (ex:predecessor AS ?path)
                    BIND (?value AS ?earlier)
                    BIND ($this AS ?later)
                }
                {
                    ?later ex:successor ?earlier .
                    BIND (ex:successor AS ?path2)
                    BIND (?later AS ?this2)
                    BIND (?earlier AS ?value2)
                } UNION {
                    ?earlier ex:predecessor ?later .
                    BIND (ex:predecessor AS ?path2)
                    BIND (?earlier AS ?this2)
                    BIND (?later AS ?value2)
                }
            }
        """ ;
    ] .

# Succession follows descent: nobody is succeeded by their own parent or
# another ancestor. The second triple reported is the first parentage step
# from the earlier person towards that ancestor.

ex:SuccessorNotAncestor a sh:NodeShape ;
    sh:targetSubjectsOf ex:successor , ex:predecessor ;
    sh:sparql [
        sh:message "Nobody is succeeded by their own ancestor" ;
        sh:select """
            SELECT $this ?path ?value ?this2 ?path2 ?value2
            WHERE {
                {
                    $this ex:successor ?value .
                    BIND (ex:successor AS ?path)
                    BIND ($this AS ?earlier)
                    BIND (?value AS ?later)
                } UNION {
                    $this ex:predecessor ?value .
                    BIND (ex:predecessor AS ?path)
                    BIND (?value AS ?earlier)
                    BIND ($this AS ?later)
                }
                {
                    ?earlier ?path2 ?step .
                    VALUES ?path2 { ex:parent ex:father ex:mother }
                    BIND (?earlier AS ?this2)
                    BIND (?step AS ?value2)
                } UNION {
                    ?step ex:child ?earlier .
                    BIND (ex:child AS ?path2)
                    BIND (?step AS ?this2)
                    BIND (?earlier AS ?value2)
                }
                ?step (ex:parent|ex:father|ex:mother|^ex:child)* ?later .
            }
        """ ;
    ] .
